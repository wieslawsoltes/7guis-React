<Page
    x:Class="SevenGuis.WebSceneHost.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#0D1320">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border
        Padding="16,12"
        Background="#121C2E"
        BorderBrush="#263550"
        BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
        <StackPanel Spacing="2">
          <TextBlock
              FontSize="20"
              FontWeight="SemiBold"
              Foreground="White"
              Text="7GUIs · React on WebScene" />
          <TextBlock
              Foreground="#9CB0CC"
              Text="React 19 · native V8/DOM/CSS scene runtime · Uno Skia · no browser or WebView" />
        </StackPanel>
        <Border
            Grid.Column="1"
            Padding="10,5"
            VerticalAlignment="Center"
            Background="#173B2C"
            CornerRadius="12">
          <TextBlock
              Foreground="#73E2A7"
              FontSize="12"
              FontWeight="SemiBold"
              Text="NATIVE RUNTIME" />
        </Border>
      </Grid>
    </Border>

    <ContentControl
        x:Name="SceneContent"
        Grid.Row="1"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch" />

    <Border
        Grid.Row="2"
        Padding="12,7"
        Background="#121C2E"
        BorderBrush="#263550"
        BorderThickness="0,1,0,0">
      <TextBlock
          x:Name="StatusText"
          Foreground="#9CB0CC"
          FontFamily="Cascadia Mono, Menlo, monospace"
          FontSize="11"
          Text="Starting WebScene native runtime…" />
    </Border>

    <Border
        x:Name="LoadFailure"
        Grid.RowSpan="3"
        Margin="30"
        Padding="20"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="#D9443F"
        CornerRadius="10"
        Visibility="Collapsed">
      <TextBlock
          x:Name="LoadFailureText"
          MaxWidth="900"
          Foreground="White"
          TextWrapping="Wrap" />
    </Border>
  </Grid>
</Page>
